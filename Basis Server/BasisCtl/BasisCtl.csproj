<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<StartupObject>Basis.Ctl.Program</StartupObject>
		<AssemblyName>basisctl</AssemblyName>
		<RootNamespace>Basis.Ctl</RootNamespace>
		<InvariantGlobalization>true</InvariantGlobalization>
		<ServerGarbageCollection>false</ServerGarbageCollection>
		<ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\BasisServerConsole\BasisControlProtocol.cs" Link="Shared\BasisControlProtocol.cs" />
		<Compile Include="..\BasisServerConsole\BasisConsoleDriver.cs" Link="Shared\BasisConsoleDriver.cs" />
	</ItemGroup>

</Project>
