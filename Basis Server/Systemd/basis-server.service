[Unit]
Description=Basis Server
Documentation=https://github.com/BasisVR/Basis
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=notify
User=basis
Group=basis
WorkingDirectory=/opt/basis-server
ExecStart=/opt/basis-server/BasisNetworkConsole
Restart=on-failure
RestartSec=5
SuccessExitStatus=75
RestartForceExitStatus=75
RestartPreventExitStatus=78
TimeoutStartSec=120
TimeoutStopSec=30
WatchdogSec=60
RuntimeDirectory=basis-server
RuntimeDirectoryMode=0750
UMask=0027
SyslogIdentifier=basis-server
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
