    { "key": "settings.developer.bugReport.logs", "value": "日志文件 *" },
    { "key": "settings.developer.bugReport.logs.tooltip", "value": "问题附近的日志片段。使用“附加近期日志”可从当前会话填充此项。" },
    { "key": "settings.developer.bugReport.attachLogs", "value": "附加近期日志" },
