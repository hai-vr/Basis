    },
    {
      "key": "notification.exception.dismiss",
      "value": "閉じる"
    },
    {
      "key": "notification.exception.unknownSystem",
      "value": "Basis システム"
    },
    {
      "key": "notification.exception.copyHint",
      "value": "「詳細をコピー」で完全なスタックトレースをコピーできます。"
    }
  ]
}
