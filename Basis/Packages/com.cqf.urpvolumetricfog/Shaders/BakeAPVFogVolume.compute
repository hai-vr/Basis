// Bakes Unity's Adaptive Probe Volume (APV) irradiance into a world-space 3D texture for the
// volumetric fog's baked APV mode. At fog render time, one trilinear tap into the result replaces the
// per-step APV SH reconstruction. Static: only re-run when the APV bake itself changes.
//
// IMPORTANT: must be dispatched from inside the render graph during a camera render, where URP has
// bound the APV runtime resources globally. A bare ComputeShader.Dispatch outside the frame would
// sample nothing (the APV constant buffer / SH textures would be unbound).

#pragma kernel CSBakeAPVFogVolume

// Match URP's global APV keyword so EvaluateAdaptiveProbeVolume resolves to the active L1/L2 variant.
#pragma multi_compile _ PROBE_VOLUMES_L1 PROBE_VOLUMES_L2

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

#if defined(PROBE_VOLUMES_L1) || defined(PROBE_VOLUMES_L2)
    #include "Packages/com.unity.render-pipelines.core/Runtime/Lighting/ProbeVolume/ProbeVolume.hlsl"
#endif

RWTexture3D<float4> _BakeResult;
float3 _BakeBoundsMin;    // world-space min corner of the baked volume
float3 _BakeBoundsSize;   // world-space size of the baked volume
uint3  _BakeResolution;   // voxel count per axis

[numthreads(4, 4, 4)]
void CSBakeAPVFogVolume(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= _BakeResolution))
        return;

    // World position at the voxel center.
    float3 uvw = (float3(id) + 0.5) / float3(_BakeResolution);
    float3 posWS = _BakeBoundsMin + uvw * _BakeBoundsSize;

    float3 irradiance = float3(0.0, 0.0, 0.0);
    float coverage = 0.0;
#if defined(PROBE_VOLUMES_L1) || defined(PROBE_VOLUMES_L2)
    // positionSS only drives APV's screen-space dither for leak reduction; a stable per-voxel value is
    // fine for a bake. The fog applies the contribution weight at sample time, so bake unweighted.
    EvaluateAdaptiveProbeVolume(posWS, float2(id.xy), irradiance);

    // Coverage = is this voxel inside valid APV probe data? Mirror the internal test the evaluation
    // above uses (TryToGetPoolUVW, after the world offset). Stored in alpha so the fog can fade its
    // baked ambient out of uncovered space (inside geometry / beyond the probe volume) instead of
    // smearing APV's flat ambient fallback there. // VALIDATE: FillAPVResources / TryToGetPoolUVW names.
    APVResources apvRes = FillAPVResources();
    float3 coverageUVW;
    coverage = TryToGetPoolUVW(apvRes, posWS - _APVWorldOffset, 0, 0, coverageUVW) ? 1.0 : 0.0;
#endif

    _BakeResult[id] = float4(irradiance, coverage);
}
