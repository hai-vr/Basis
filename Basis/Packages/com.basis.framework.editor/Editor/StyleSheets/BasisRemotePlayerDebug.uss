.brp-root {
    flex-grow: 1;
}

.brp-card {
    background-color: rgba(0, 0, 0, 0.54);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-width: 10px;
    border-bottom-color: rgba(0, 0, 0, 0);
    margin-bottom: 5px;
    margin-left: 3px;
    margin-right: 3px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    padding-right: 6px;
}

.brp-header-card {
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
}

.brp-header-title {
    -unity-font-style: bold;
    font-size: 40px;
    -unity-text-align: upper-center;
    color: rgb(239, 40, 90);
    margin-top: 4px;
}

.brp-header-subtitle {
    -unity-text-align: upper-center;
    color: rgb(190, 190, 190);
    font-size: 12px;
    margin-bottom: 6px;
}

.brp-section-title {
    -unity-font-style: bold;
    font-size: 12px;
    color: rgb(239, 40, 90);
    margin-top: 6px;
    margin-bottom: 2px;
}

.brp-foldout {
    background-color: rgba(0, 0, 0, 0.54);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-width: 10px;
    border-bottom-color: rgba(0, 0, 0, 0);
    margin-bottom: 5px;
    margin-left: 3px;
    margin-right: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    padding-top: 2px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
}

.brp-foldout > .unity-foldout__content {
    margin-left: 4px;
    -unity-font-style: normal;
}

.brp-status-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 4px;
    padding-right: 4px;
}

.brp-status-label {
    -unity-font-style: normal;
    color: rgb(200, 200, 200);
    flex-grow: 1;
    flex-shrink: 1;
}

.brp-status-value {
    -unity-font-style: bold;
    color: rgb(230, 230, 230);
    -unity-text-align: middle-right;
    flex-shrink: 0;
    white-space: normal;
}

.brp-status-pill {
    -unity-font-style: bold;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 8px;
    padding-right: 8px;
    -unity-text-align: middle-center;
    min-width: 44px;
    flex-shrink: 0;
}

.brp-pill-neutral {
    background-color: rgba(80, 80, 80, 1);
    color: rgb(220, 220, 220);
}

.brp-pill-good {
    background-color: rgba(45, 140, 60, 1);
    color: rgb(240, 255, 240);
}

.brp-pill-bad {
    background-color: rgba(160, 50, 50, 1);
    color: rgb(255, 235, 235);
}

.brp-pill-warn {
    background-color: rgba(170, 130, 30, 1);
    color: rgb(255, 250, 230);
}

.brp-help-info {
    background-color: rgba(40, 70, 100, 0.6);
    color: rgb(220, 230, 240);
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    margin-top: 4px;
    white-space: normal;
}

.brp-help-warn {
    background-color: rgba(110, 80, 20, 0.7);
    color: rgb(255, 240, 210);
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    margin-top: 4px;
    white-space: normal;
}

.brp-help-error {
    background-color: rgba(120, 30, 30, 0.7);
    color: rgb(255, 220, 220);
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    margin-top: 4px;
    white-space: normal;
}

.brp-bar-track {
    background-color: rgb(38, 38, 38);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    height: 12px;
    flex-grow: 1;
    overflow: hidden;
    margin-top: 2px;
    margin-bottom: 2px;
    margin-left: 4px;
    margin-right: 4px;
}

.brp-bar-fill {
    background-color: rgb(50, 178, 255);
    height: 12px;
    width: 0;
}

.brp-mini-note {
    color: rgb(160, 160, 160);
    font-size: 10px;
    margin-top: 2px;
    margin-left: 4px;
    white-space: normal;
}

.brp-scroll {
    flex-grow: 1;
}

.brp-scroll > .unity-scroll-view__content-container {
    flex-grow: 1;
}

.brp-search {
    margin-bottom: 2px;
}

.brp-controls-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.brp-slider {
    flex-grow: 1;
    margin-left: 4px;
    margin-right: 4px;
}

.brp-button {
    background-color: rgb(80, 80, 80);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 8px;
    padding-right: 8px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 2px;
    margin-right: 2px;
    min-width: 32px;
}

.brp-button:hover {
    background-color: rgb(100, 100, 100);
}

.brp-position {
    -unity-text-align: middle-right;
    color: rgb(180, 180, 180);
    font-size: 11px;
    margin-top: 3px;
    margin-right: 4px;
}

.brp-current-name {
    -unity-font-style: bold;
    font-size: 16px;
    color: rgb(235, 235, 235);
    -unity-text-align: middle-left;
}

.brp-current-sub {
    color: rgb(160, 160, 160);
    font-size: 11px;
    white-space: normal;
    margin-top: 1px;
}
