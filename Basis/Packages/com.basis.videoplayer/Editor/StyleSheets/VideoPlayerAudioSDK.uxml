<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement class="bvp-root">
        <engine:VisualElement name="HeaderCard" class="bvp-card bvp-header-card">
            <engine:Label text="Basis Video Audio" name="HeaderTitle" selectable="false" class="bvp-header-title"/>
            <engine:Label text="Streaming AudioClip sink + IBasisMediaClockSource" name="HeaderSubtitle" selectable="false" class="bvp-header-subtitle"/>
        </engine:VisualElement>

        <engine:Foldout text="Output" name="OutputFoldout" value="true" class="bvp-foldout">
            <editor:ObjectField label="Target Audio Source" name="TargetAudioSourceField" type="UnityEngine.AudioSource, UnityEngine.AudioModule" allow-scene-objects="true"/>
            <engine:Toggle label="Assign Clip On Awake" name="AssignClipOnAwakeField"/>
            <engine:TextField label="Clip Name" name="ClipNameField"/>
        </engine:Foldout>

        <engine:Foldout text="Format" name="FormatFoldout" value="false" class="bvp-foldout">
            <engine:IntegerField label="Sample Rate" name="SampleRateField" tooltip="Auto-updated from the first incoming audio frame."/>
            <engine:SliderInt label="Channel Count" name="ChannelCountField" low-value="1" high-value="2" show-input-field="true"/>
        </engine:Foldout>

        <engine:Foldout text="Buffering" name="BufferingFoldout" value="false" class="bvp-foldout">
            <engine:FloatField label="Clip Length (s)" name="ClipLengthField" tooltip="Larger = coarser PCM callbacks; ~1.0 keeps callbacks around 80 ms."/>
            <engine:IntegerField label="Max Queued Frames" name="MaxQueuedField" tooltip="0 = unbounded."/>
            <engine:Toggle label="Drop Oldest On Overflow" name="DropOldestField"/>
            <engine:IntegerField label="Rebuffer Frames" name="RebufferField" tooltip="After underrun, stay silent until this many frames have queued."/>
        </engine:Foldout>

        <engine:Foldout text="Playback" name="PlaybackFoldout" value="true" class="bvp-foldout">
            <engine:Toggle label="Auto Play On Enable" name="AutoPlayField"/>
            <engine:Toggle label="Stop On Disable" name="StopOnDisableField"/>
            <engine:Toggle label="Clear Queue On Enable" name="ClearQueueOnEnableField"/>
            <engine:Slider label="Volume Gain" name="VolumeGainField" low-value="0" high-value="2" show-input-field="true" tooltip="Sample-domain multiplier applied after decode (hard-capped at 2.0 at runtime)."/>
            <engine:Toggle label="Mute" name="MuteField"/>
        </engine:Foldout>

        <engine:Foldout text="Live Status" name="StatusFoldout" value="true" class="bvp-foldout">
            <engine:VisualElement class="bvp-status-grid">
                <engine:VisualElement class="bvp-status-row"><engine:Label text="Has Audio Source" class="bvp-status-label"/><engine:Label text="—" name="StatusHasSource" class="bvp-status-pill bvp-pill-neutral"/></engine:VisualElement>
                <engine:VisualElement class="bvp-status-row"><engine:Label text="Source Playing" class="bvp-status-label"/><engine:Label text="—" name="StatusPlaying" class="bvp-status-pill bvp-pill-neutral"/></engine:VisualElement>
                <engine:VisualElement class="bvp-status-row"><engine:Label text="Has Media Anchor" class="bvp-status-label"/><engine:Label text="—" name="StatusAnchor" class="bvp-status-pill bvp-pill-neutral"/></engine:VisualElement>
                <engine:VisualElement class="bvp-status-row"><engine:Label text="Media Time" class="bvp-status-label"/><engine:Label text="—" name="StatusMediaTime" class="bvp-status-value"/></engine:VisualElement>
                <engine:VisualElement class="bvp-status-row"><engine:Label text="Consumed Samples" class="bvp-status-label"/><engine:Label text="—" name="StatusConsumed" class="bvp-status-value"/></engine:VisualElement>
                <engine:VisualElement class="bvp-status-row"><engine:Label text="Dropped (total)" class="bvp-status-label"/><engine:Label text="—" name="StatusDropped" class="bvp-status-value"/></engine:VisualElement>
                <engine:VisualElement class="bvp-status-row"><engine:Label text="PCM Peak / RMS" class="bvp-status-label"/><engine:Label text="—" name="StatusPcmLevels" class="bvp-status-value"/></engine:VisualElement>
                <engine:VisualElement class="bvp-status-row"><engine:Label text="Latency (out)" class="bvp-status-label"/><engine:Label text="—" name="StatusLatency" class="bvp-status-value"/></engine:VisualElement>
            </engine:VisualElement>

            <engine:Label text="Queue Depth" class="bvp-section-title" style="margin-top: 6px;"/>
            <engine:VisualElement class="bvp-bar-row">
                <engine:Label text="Audio frames" class="bvp-bar-label"/>
                <engine:VisualElement class="bvp-bar-track">
                    <engine:VisualElement name="StatusDepthFill" class="bvp-bar-fill bvp-bar-fill-audio"/>
                </engine:VisualElement>
                <engine:Label text="—" name="StatusDepthValue" class="bvp-bar-value"/>
            </engine:VisualElement>
            <engine:Label text="Enter Play Mode for live values." name="StatusEditModeHint" class="bvp-help-info"/>
        </engine:Foldout>

        <engine:VisualElement name="ActionsCard" class="bvp-card bvp-actions-card">
            <engine:Button text="Clear Queue" name="ClearQueueButton" class="bvp-primary-button"/>
            <engine:Button text="Reset Sync Anchor" name="ResetAnchorButton" class="bvp-secondary-button"/>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
