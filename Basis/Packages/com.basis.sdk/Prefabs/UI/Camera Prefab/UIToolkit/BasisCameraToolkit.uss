/* =========================================================
   Basis handheld camera — UI Toolkit skin
   Design tokens lifted from basisvr.org: Inter, #100f27 base,
   #ef1237 brand, translucent white surfaces, 16px radii.
   ========================================================= */

:root {
    --basis-bg: rgb(16, 15, 39);
    --basis-bg-deep: rgb(10, 9, 26);
    --brand: rgb(239, 18, 55);
    --brand-soft: rgba(239, 18, 55, 0.25);
    --purple: rgb(147, 51, 234);
    --blue: rgb(59, 130, 246);

    --surface: rgba(255, 255, 255, 0.05);
    --surface-strong: rgba(255, 255, 255, 0.1);
    --hairline: rgba(255, 255, 255, 0.12);

    --text: rgb(255, 255, 255);
    --text-dim: rgb(209, 213, 219);
    --text-mute: rgb(156, 163, 175);

    --radius-lg: 16px;
    --radius-md: 12px;
    --radius-sm: 8px;
}

/* ---------- base ---------- */

.cam-root {
    flex-grow: 1;
    background-color: var(--basis-bg);
    -unity-font-definition: url("project://database/Packages/com.basis.sdk/Fonts/Inter_24pt-Regular.ttf");
    color: var(--text);
    font-size: 15px;
    padding: 14px;
    flex-direction: row;
}

.col {
    flex-direction: column;
}

.spacer {
    flex-grow: 1;
}

/* ---------- cards ---------- */

.card {
    background-color: var(--surface);
    border-radius: var(--radius-lg);
    border-width: 1px;
    border-color: var(--hairline);
    padding: 12px;
    margin-bottom: 10px;
}

.card__title {
    font-size: 12px;
    color: var(--text-mute);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 8px;
}

/* ---------- viewfinder ---------- */

.viewfinder {
    flex-grow: 1;
    border-radius: var(--radius-lg);
    background-color: var(--basis-bg-deep);
    border-width: 1px;
    border-color: var(--hairline);
    overflow: hidden;
    justify-content: space-between;
}

.viewfinder--recording {
    border-color: var(--brand);
    border-width: 2px;
}

.vf-strip {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    background-color: rgba(10, 9, 26, 0.55);
}

.vf-strip--bottom {
    justify-content: space-between;
}

/* framing guides */
.vf-guide {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.14);
}

.vf-guide--v {
    top: 0;
    bottom: 0;
    width: 1px;
}

.vf-guide--h {
    left: 0;
    right: 0;
    height: 1px;
}

/* ---------- pills / status ---------- */

.pill {
    border-radius: 999px;
    background-color: var(--surface-strong);
    color: var(--text-dim);
    font-size: 12px;
    padding: 3px 10px;
    margin-right: 6px;
    -unity-text-align: middle-center;
}

.pill--accent {
    background-color: var(--brand-soft);
    color: var(--text);
}

.pill--live {
    background-color: var(--brand);
    color: var(--text);
    -unity-font-style: bold;
}

/* ---------- readouts (exposure triangle etc.) ---------- */

.readout {
    align-items: center;
    min-width: 74px;
}

.readout__label {
    font-size: 10px;
    color: var(--text-mute);
    letter-spacing: 1px;
}

.readout__value {
    font-size: 20px;
    color: var(--text);
    -unity-font-style: bold;
}

.readout__value--accent {
    color: var(--brand);
}

/* ---------- icon rail ---------- */

.rail {
    width: 68px;
    margin-right: 12px;
}

.icon-btn {
    width: 56px;
    height: 56px;
    margin-bottom: 8px;
    border-radius: var(--radius-md);
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--hairline);
    color: var(--text-dim);
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: normal;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s;
}

.icon-btn:hover {
    background-color: var(--surface-strong);
    border-color: rgba(255, 255, 255, 0.28);
    color: var(--text);
}

.icon-btn:active {
    scale: 0.95;
}

.icon-btn--on {
    background-color: var(--brand-soft);
    border-color: var(--brand);
    color: var(--text);
}

/* ---------- shutter ---------- */

.shutter {
    width: 88px;
    height: 88px;
    border-radius: 999px;
    background-color: var(--brand);
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.85);
    color: var(--text);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    align-self: center;
    margin-top: 8px;
    transition-property: scale, background-color;
    transition-duration: 0.1s;
}

.shutter:hover {
    background-color: rgb(255, 60, 90);
}

.shutter:active {
    scale: 0.92;
}

/* ---------- settings column ---------- */

.settings {
    width: 380px;
    margin-left: 12px;
}

.settings__scroll {
    flex-grow: 1;
}

/* ---------- rows ---------- */

.row {
    margin-bottom: 10px;
}

.row__head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2px;
}

.row__label {
    font-size: 13px;
    color: var(--text-dim);
}

.row__value {
    font-size: 13px;
    color: var(--text);
    -unity-font-style: bold;
}

/* ---------- sliders ---------- */

.cam-slider {
    margin: 0;
    height: 18px;
}

.cam-slider .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    border-width: 0;
    height: 4px;
    margin-top: 7px;
}

.cam-slider .unity-base-slider__dragger {
    background-color: var(--text);
    border-radius: 999px;
    border-width: 0;
    width: 16px;
    height: 16px;
    margin-top: 1px;
}

.cam-slider:hover .unity-base-slider__dragger {
    background-color: var(--brand);
}

/* ---------- toggles ---------- */

.cam-toggle {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.cam-toggle .unity-toggle__label {
    font-size: 13px;
    color: var(--text-dim);
    margin-right: 8px;
}

.cam-toggle .unity-toggle__checkmark {
    width: 18px;
    height: 18px;
    border-radius: var(--radius-sm);
    background-color: var(--surface-strong);
    border-width: 1px;
    border-color: var(--hairline);
}

.cam-toggle:checked .unity-toggle__checkmark {
    background-color: var(--brand);
    border-color: var(--brand);
}

/* ---------- dropdowns ---------- */

.cam-dropdown {
    margin: 0;
}

.cam-dropdown .unity-base-popup-field__input {
    background-color: var(--surface-strong);
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: var(--hairline);
    color: var(--text);
    padding: 5px 8px;
}

/* ---------- misc ---------- */

.divider {
    height: 1px;
    background-color: var(--hairline);
    margin: 6px 0;
}

.hint {
    font-size: 11px;
    color: var(--text-mute);
    white-space: normal;
}
