<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="BasisCameraToolkit.uss" />

    <ui:VisualElement name="cam-root" class="cam-root">

        <!-- ============ left rail: mode toggles ============ -->
        <ui:VisualElement name="rail" class="rail col">
            <ui:Button name="btn-selfie" text="SELFIE" class="icon-btn" />
            <ui:Button name="btn-autolevel" text="LEVEL" class="icon-btn" />
            <ui:Button name="btn-smoothing" text="STEADY" class="icon-btn" />
            <ui:Button name="btn-follow" text="FOLLOW" class="icon-btn" />
            <ui:Button name="btn-fly" text="FLY" class="icon-btn" />
            <ui:Button name="btn-nameplates" text="NAMES" class="icon-btn" />
            <ui:Button name="btn-desktop" text="DESKTOP" class="icon-btn" />
            <ui:Button name="btn-video" text="STREAM" class="icon-btn" />
            <ui:VisualElement class="spacer" />
            <ui:Button name="btn-close" text="EXIT" class="icon-btn" />
        </ui:VisualElement>

        <!-- ============ centre: viewfinder + actions ============ -->
        <ui:VisualElement name="centre" class="col spacer">

            <ui:VisualElement name="viewfinder" class="viewfinder">
                <ui:VisualElement name="vf-top" class="vf-strip">
                    <ui:Label name="pill-res" text="1080P" class="pill pill--accent" />
                    <ui:Label name="pill-format" text="PNG" class="pill" />
                    <ui:Label name="pill-360" text="360" class="pill" />
                    <ui:VisualElement class="spacer" />
                    <ui:Label name="pill-live" text="STREAM" class="pill pill--live" />
                </ui:VisualElement>

                <ui:VisualElement class="spacer" />

                <ui:VisualElement name="vf-bottom" class="vf-strip vf-strip--bottom">
                    <ui:VisualElement class="readout">
                        <ui:Label text="FOV" class="readout__label" />
                        <ui:Label name="read-fov" text="50" class="readout__value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="readout">
                        <ui:Label text="EV" class="readout__label" />
                        <ui:Label name="read-ev" text="0.0" class="readout__value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="readout">
                        <ui:Label text="APERTURE" class="readout__label" />
                        <ui:Label name="read-aperture" text="f/2.8" class="readout__value readout__value--accent" />
                    </ui:VisualElement>
                    <ui:VisualElement class="readout">
                        <ui:Label text="SHUTTER" class="readout__label" />
                        <ui:Label name="read-shutter" text="1/60" class="readout__value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="readout">
                        <ui:Label text="ISO" class="readout__label" />
                        <ui:Label name="read-iso" text="400" class="readout__value" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="actions" class="vf-strip">
                <ui:Button name="btn-timer" text="TIMER" class="icon-btn" />
                <ui:VisualElement class="spacer" />
                <ui:Button name="btn-shutter" text="CAPTURE" class="shutter" />
                <ui:VisualElement class="spacer" />
                <ui:Button name="btn-reset" text="RESET" class="icon-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ============ right: settings ============ -->
        <ui:VisualElement name="settings" class="settings col">
            <ui:ScrollView name="settings-scroll" class="settings__scroll">

                <ui:VisualElement class="card">
                    <ui:Label text="EXPOSURE" class="card__title" />
                    <ui:VisualElement class="row">
                        <ui:VisualElement class="row__head">
                            <ui:Label text="Compensation" class="row__label" />
                            <ui:Label name="val-ev" text="0.0 EV" class="row__value" />
                        </ui:VisualElement>
                        <ui:Slider name="sld-ev" low-value="0" high-value="12" class="cam-slider" />
                    </ui:VisualElement>
                    <ui:DropdownField name="dd-aperture" label="Aperture" class="cam-dropdown" />
                    <ui:DropdownField name="dd-shutter" label="Shutter" class="cam-dropdown" />
                    <ui:DropdownField name="dd-iso" label="ISO" class="cam-dropdown" />
                </ui:VisualElement>

                <ui:VisualElement class="card">
                    <ui:Label text="LENS" class="card__title" />
                    <ui:VisualElement class="row">
                        <ui:VisualElement class="row__head">
                            <ui:Label text="Field of view" class="row__label" />
                            <ui:Label name="val-fov" text="50°" class="row__value" />
                        </ui:VisualElement>
                        <ui:Slider name="sld-fov" low-value="20" high-value="120" class="cam-slider" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="card">
                    <ui:Label text="DEPTH OF FIELD" class="card__title" />
                    <ui:Toggle name="tgl-dof" label="Enabled" class="cam-toggle" />
                    <ui:VisualElement name="dof-mode" class="row__head">
                        <ui:Button name="btn-dof-auto" text="AUTO" class="icon-btn" />
                        <ui:Button name="btn-dof-manual" text="MANUAL" class="icon-btn" />
                    </ui:VisualElement>
                    <ui:VisualElement name="row-dof-focus" class="row">
                        <ui:VisualElement class="row__head">
                            <ui:Label text="Focus distance" class="row__label" />
                            <ui:Label name="val-dof-focus" text="10.0 m" class="row__value" />
                        </ui:VisualElement>
                        <ui:Slider name="sld-dof-focus" low-value="0.1" high-value="100" class="cam-slider" />
                    </ui:VisualElement>
                    <ui:VisualElement name="row-dof-aperture" class="row">
                        <ui:VisualElement class="row__head">
                            <ui:Label text="Blur aperture" class="row__label" />
                            <ui:Label name="val-dof-aperture" text="1.0" class="row__value" />
                        </ui:VisualElement>
                        <ui:Slider name="sld-dof-aperture" low-value="0" high-value="32" class="cam-slider" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="card">
                    <ui:Label text="IMAGE" class="card__title" />
                    <ui:VisualElement class="row">
                        <ui:VisualElement class="row__head">
                            <ui:Label text="Bloom intensity" class="row__label" />
                            <ui:Label name="val-bloom-i" text="0.50" class="row__value" />
                        </ui:VisualElement>
                        <ui:Slider name="sld-bloom-i" low-value="0" high-value="5" class="cam-slider" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row">
                        <ui:VisualElement class="row__head">
                            <ui:Label text="Bloom threshold" class="row__label" />
                            <ui:Label name="val-bloom-t" text="0.50" class="row__value" />
                        </ui:VisualElement>
                        <ui:Slider name="sld-bloom-t" low-value="0.1" high-value="2" class="cam-slider" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row">
                        <ui:VisualElement class="row__head">
                            <ui:Label text="Contrast" class="row__label" />
                            <ui:Label name="val-contrast" text="0" class="row__value" />
                        </ui:VisualElement>
                        <ui:Slider name="sld-contrast" low-value="-100" high-value="100" class="cam-slider" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row">
                        <ui:VisualElement class="row__head">
                            <ui:Label text="Saturation" class="row__label" />
                            <ui:Label name="val-saturation" text="0" class="row__value" />
                        </ui:VisualElement>
                        <ui:Slider name="sld-saturation" low-value="-100" high-value="100" class="cam-slider" />
                    </ui:VisualElement>
                    <ui:VisualElement name="row-fog" class="row">
                        <ui:VisualElement class="row__head">
                            <ui:Label text="Volumetric fog" class="row__label" />
                            <ui:Label name="val-fog" text="0%" class="row__value" />
                        </ui:VisualElement>
                        <ui:Slider name="sld-fog" low-value="0" high-value="1" class="cam-slider" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="card">
                    <ui:Label text="CAPTURE" class="card__title" />
                    <ui:VisualElement class="row__head">
                        <ui:Button name="btn-resolution" text="RESOLUTION" class="icon-btn" />
                        <ui:Button name="btn-format" text="FORMAT" class="icon-btn" />
                        <ui:Button name="btn-360" text="360" class="icon-btn" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="card">
                    <ui:Label text="FOLLOW" class="card__title" />
                    <ui:VisualElement class="row">
                        <ui:VisualElement class="row__head">
                            <ui:Label text="Height" class="row__label" />
                            <ui:Label name="val-follow-h" text="0.00 m" class="row__value" />
                        </ui:VisualElement>
                        <ui:Slider name="sld-follow-h" low-value="-1" high-value="2" class="cam-slider" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row">
                        <ui:VisualElement class="row__head">
                            <ui:Label text="Side" class="row__label" />
                            <ui:Label name="val-follow-s" text="0.00 m" class="row__value" />
                        </ui:VisualElement>
                        <ui:Slider name="sld-follow-s" low-value="-2" high-value="2" class="cam-slider" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="card-video" class="card">
                    <ui:Label text="VIDEO OUTPUT" class="card__title" />
                    <ui:VisualElement class="row">
                        <ui:VisualElement class="row__head">
                            <ui:Label text="Resolution" class="row__label" />
                            <ui:Label name="val-vid-res" text="1920x1080" class="row__value" />
                        </ui:VisualElement>
                        <ui:Slider name="sld-vid-res" low-value="0" high-value="3" class="cam-slider" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row">
                        <ui:VisualElement class="row__head">
                            <ui:Label text="Frame rate" class="row__label" />
                            <ui:Label name="val-vid-fps" text="30 fps" class="row__value" />
                        </ui:VisualElement>
                        <ui:Slider name="sld-vid-fps" low-value="15" high-value="120" class="cam-slider" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:ScrollView>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
