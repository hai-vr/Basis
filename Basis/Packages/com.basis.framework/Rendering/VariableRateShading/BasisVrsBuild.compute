#pragma kernel CSMain

RWTexture2D<uint> _BasisSri;

float4 _BasisVrsCenterLR;
float4 _BasisVrsParams;
float4 _BasisVrsTile;
float4 _BasisVrsRates;

uint RateForCenter(float2 uv, float2 center, float inner, float outer, float aspect, uint rateNear, uint rateMid, uint rateFar)
{
    float2 d = uv - center;
    d.x *= aspect;
    float dist = length(d);
    if (dist < inner) return rateNear;
    if (dist < outer) return rateMid;
    return rateFar;
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    int2 tileCount = (int2)_BasisVrsTile.xy;
    if ((int)id.x >= tileCount.x || (int)id.y >= tileCount.y)
        return;

    float2 uv = (float2(id.xy) + 0.5) / _BasisVrsTile.xy;

    float inner = _BasisVrsParams.x;
    float outer = _BasisVrsParams.y;
    float aspect = _BasisVrsParams.z;

    uint rateNear = (uint)_BasisVrsRates.x;
    uint rateMid = (uint)_BasisVrsRates.y;
    uint rateFar = (uint)_BasisVrsRates.z;

    uint rateL = RateForCenter(uv, _BasisVrsCenterLR.xy, inner, outer, aspect, rateNear, rateMid, rateFar);
    uint rateR = RateForCenter(uv, _BasisVrsCenterLR.zw, inner, outer, aspect, rateNear, rateMid, rateFar);

    _BasisSri[id.xy] = min(rateL, rateR);
}
